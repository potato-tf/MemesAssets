"VertexLitGeneric"
{
	"$basetexture" "models/monado/monado"
	"$bumpmap" "models/monado/monado_n"

	"$envmap" "env_cubemap"
	"$envmapmask" "models/monado/monado"
	"$envmaptint" "[0.05 0.05 0.05]"

	//"$basemapalphaphongmask" "1"
	"$phong" "1"
	"$phongexponent" "20"
	"$phongboost" ".1"	
	"$phongfresnelranges"	"[.3 1 8]"
	"$halflambert" "0"

	"$rimlight" "1"
	"$rimlightexponent" "4"	
	"$rimlightboost" "2"
	"$ambientocclusion" "1"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}
