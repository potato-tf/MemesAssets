		{
			Line "{red}...HAVE I MET YOU BEFORE?"
			Line "{red}YOU SEEM FAMILIAR."
		}
        SpawnTemplate "w1_pop"
		SpawnTemplate "hud_name_change_0"
        StartWaveOutput
        {
            Target wave_start_relay
            Action Trigger
        }
        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }
        
		WaveSpawn
        {
            Name "Dialogue-1"
            WaitBeforeStarting 0
			FirstSpawnOutput
			{
				Target prop_idle
				Action enable
			}
         
        }
        WaveSpawn
        {
            Name "Dialogue-1"
            WaitBeforeStarting 3

