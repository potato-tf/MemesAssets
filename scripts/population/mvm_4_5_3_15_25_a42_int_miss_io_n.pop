    TeleChain_Start
    {
      NoFixup 1
      KeepAlive 1

      info_target
      {
        "targetname" "tele_chain_location"
      }
    }

    TeleChain_Continue
    {
      KeepAlive 1

      OnSpawnOutput
            {
                Target "!activator"
                Action "$TeleportToEntity"
        Param "tele_chain_location"
                Delay 0.05
            }

      OnSpawnOutput
            {
                Target "tele_chain_location"
                Action "SetParent"
        Param "!activator"
                Delay 0.1
            }

      OnSpawnOutput
            {
                Target "tele_chain_location"
                Action "$SetLocalOrigin"
        Param "0 0 10"
                Delay 0.1
            }
    }

    TeleChain_End 
    {
      OnSpawnOutput
			{
				Target "!activator"
				Action "$TeleportToEntity"
        Param "tele_chain_location"
				Delay 0.05
			}

      OnSpawnOutput
			{
				Target "tele_chain_location"
				Action "Kill"
				Delay 0.1
			}
    }
