            }
            ambient_generic
            {
                "origin"                "0 0 0"
                "health"                "10"
                "message"               "ambient/lightsoff.wav"
                "pitch"                 "100"
                "pitchstart"            "100"
                "preset"                "0"
                "radius"                "-1"
                "spawnflags"            "49"
                "volume"                "100"
                "targetname"            "switchoff"
            }
            ambient_generic
            {
                "origin"                "0 0 0"
                "health"                "10"
                "message"               "ambient/lightson.wav"
                "pitch"                 "100"
                "pitchstart"            "100"
                "preset"                "0"
                "radius"                "-1"
                "spawnflags"            "49"
                "volume"                "100"
                "targetname"            "switchon"
            }
            logic_relay
            {
                "targetname"            "blackout_trigger"

                "OnTrigger"             "blackout_short,Fade,0,0,-1"
                "OnTrigger"             "switchoff,PlaySound,,0,-1"
                "OnTrigger"             "switchon,PlaySound,,1.5,-1"
            }
        }
