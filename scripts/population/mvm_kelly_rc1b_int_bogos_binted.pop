// Bogos Binted by Tindall Berry
// Kelly Intermediate / April Fools 4 Trash

#base robot_giant.pop
#base robot_standard.pop

population
{
	StartingCurrency	500
	RespawnWaveTime	2
	CanBotsAttackWhileInSpawnRoom	no
	FixedRespawnWaveTime	Yes
	BotPushaway	0 [$SIGSEGV]
	NoRomevisionCosmetics	1 [$SIGSEGV]
	TextPrintTime	0 [$SIGSEGV]
	BodyPartScaleSpeed	16 [$SIGSEGV]
	PrecacheModel "models\props\eban\moai.mdl" [$SIGSEGV]
	PrecacheModel "models\props\eban\moai_big.mdl" [$SIGSEGV]
	PrecacheModel "models\dababy_car\lilchewchew_v3.mdl" [$SIGSEGV]
	PrecacheModel "models\props_halloween\hwn_spellbook_magazine.mdl" [$SIGSEGV]
	PrecacheModel "models\props_halloween\flask_florence.mdl" [$SIGSEGV]
	PrecacheModel "models\props_halloween\flask_tub.mdl" [$SIGSEGV]
	PrecacheModel "models\props_halloween\eyeball_projectile.mdl" [$SIGSEGV]
	CustomUpgradesFile	"mvm_upgrades_tindall_v3.txt" [$SIGSEGV]
	// Upgrade changes:
	// Melee resistance added: 20% bonus, 300 cost, 3 points
	// Health regen cost lowered from 200 to 100
	// Metal regen cost lowered from 200 to 100
	// Mark for death disabled
	// Rocket specialist bonus increased from 1 to 2, cost increased from 300 to 500, number of points lowered from 4 to 1
	// Banner buff duration bonus increased from 25% to 100%
	// Afterburn duration disabled
	// Thermal thruster stun on land cost increased from 300 to 500
	// Thermal thruster air launch cost lowered from 400 to 200
	// Explode on ignite cost increased from 400 to 1600
	// Demoman damage bonus cost lowered from 500 to 400
	// Shield knockback resistance bonus increased from 30% to 33%
	// Destroy projectiles bonus increased from 1 to 2, cost increased from 400 to 600
	// Heavy firing speed bonus increased from 10% to 15%, cost increased from 350 to 450, number of points lowered from 4 to 3
	// Disposable mini sentry cost lowered from 500 to 300, number of points increased from 1 to 3
	// Sentry firing speed bonus increased from 10% to 15%, cost increased from 350 to 400, number of points lowered from 3 to 1
	// Two way teleporter cost lowered from 250 to 150
	// Explosive headshot cost increased from 350 to 500, number of points lowered from 3 to 1
	// Sapper power bonus increased from 1 to 3, cost increased from 350 to 500, number of points lowered from 3 to 1
